# Neon Postgres connection string
DATABASE_URL=

# Telegram bot (from @BotFather) — never commit the real value
TELEGRAM_BOT_TOKEN=
# Your personal Telegram numeric user id — only this id gets admin access
ADMIN_TELEGRAM_ID=
# Random long string, also passed to setWebhook — verifies webhook calls really come from Telegram
TELEGRAM_WEBHOOK_SECRET=

# Public URL of the deployed app (used for the bot's menu button + webhook)
APP_URL=
